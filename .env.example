# DesignDoctor AI — environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# bedrock  = Amazon Bedrock (required for final submission)
# ugmdu    = AWS User Group Madurai cloud (free during hackathon, for development)
# local    = Ollama on this machine
LLM_PROVIDER=bedrock

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_SMALL_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_MEDIUM_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_LARGE_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_REGION=us-east-1
AWS_PROFILE=default

# ── UGMdu cloud LLM ───────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=ugmdu
# Key from https://www.awsugmdu.in
LLM_MODEL_ID=gpt-oss-20b
# LLM_API_KEY=your_ugmdu_key_here  # defaults to DECIDER_API_KEY if not set

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=local
# OLLAMA_URL=http://127.0.0.1:11434
# LLM_MODEL_ID=qwen3.5:4b

# ── Strands Decider 2B ────────────────────────────────────────────────────────
# local  = local strands-decider server (./kit serve)
# ugmdu  = AWS User Group Madurai hosted API (recommended — no install)
DECIDER_MODE=ugmdu
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
DECIDER_API_KEY=your_ugmdu_key_here

# ── Timeouts ──────────────────────────────────────────────────────────────────
LLM_TIMEOUT_S=120

# ── Deployment (filled by ./kit deploy) ──────────────────────────────────────
# AGENTCORE_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/...
# DEPLOY_DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
# DEPLOY_DECIDER_API_KEY=your_ugmdu_key_here
